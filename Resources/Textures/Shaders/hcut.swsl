light_mode unshaded;

const highp float c = 0.3;
const highp float alphaModifier = 0.2;
const bool below = true;

void fragment()
{
    highp vec4 tex = zTexture(UV);
    highp float modifier = (UV.y > c ^^ !below) ? 1.0 : alphaModifier;

    // KS14: tex.w * modifier -> both, premultiplied. The sprite is drawn into a transparent render target, so
    //      its colour already carries its alpha and attenuating only the alpha leaves the cut half too bright.
    //      See DrawEntityPostShaders in Clyde.HLR.cs.
    COLOR = vec4(tex.rgb * modifier, tex.a * modifier);
}
