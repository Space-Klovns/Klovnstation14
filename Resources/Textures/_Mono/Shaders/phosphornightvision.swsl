uniform sampler2D SCREEN_TEXTURE;

uniform highp vec3 BASE_COLOR;
uniform highp vec3 ADDED_LIGHT_COLOR;
uniform highp float AMPLIFICATION;
uniform highp float[3] BLUR_OFFSET;
uniform highp float[3] BLUR_WEIGHT;
uniform bool IS_CONE;

// Cone controls
uniform highp float CONE_ANGLE;          // Width of the cone in degrees.
uniform highp float CONE_FEATHER;         // Softness of the side edges in degrees.
uniform highp float CONE_DISTANCE;         // How far the cone reaches from center (0–1 of screen).
uniform highp float CONE_DISTANCE_FEATHER; // Soft fade at the cone’s end (0–1 of screen).
uniform highp float VIEW_ANGLE;            // Rotation of the cone in radians.
uniform highp float FREEDOM = 0.07; // KS14: Radius of the fade-out of cone, at the same origin as the cone.
uniform highp vec2 ZOOM; // KS14

uniform highp float TIME_FRACTION;         // signed time fraction, -1..1 (see spec)
uniform highp float WIPE_FEATHER = 0.25;   // softness of the top-to-bottom wipe edge, in UV units

const highp float PI = 3.14159265359;
const highp float TAU = 6.28318530718;

const highp float staticBase = 0.7;
const highp float staticEnvMul = 2;

// Cone mask.
// Returns 1.0 inside the cone, 0.0 outside, with smooth edges.
highp float coneMask(
    highp vec2 fragcoord,
    highp vec2 screenSize,
    highp float coneAngleDeg,
    highp float coneFeatherDeg,
    highp float coneDistance,
    highp float coneDistanceFeather,
    highp float viewAngle,

    highp float freedom,
    highp vec2 zoom
) {
    highp vec2 center = screenSize * 0.5;
    highp vec2 delta = fragcoord - center;

    // Distance from screen center in pixels.
    highp float dist = length(delta * zoom);
    highp float maxDist = coneDistance * min(screenSize.x, screenSize.y);
    highp float maxDistFeather = coneDistanceFeather * min(screenSize.x, screenSize.y);

    // Radial distance falloff for the cone length.
    highp float distMask = 1.0 - smoothstep(
        maxDist - maxDistFeather,
        maxDist,
        dist
    );

    // Direction from center to fragment.
    highp vec2 dir = (dist > 0.0) ? (delta * zoom) / dist : vec2(0.0, 1.0);

    // Cone direction.
    highp vec2 coneDir = vec2(sin(-viewAngle), cos(-viewAngle));

    // Precompute these on the CPU if possible.
    highp float halfCone = radians(coneAngleDeg) * 0.5;
    highp float featherRad = radians(coneFeatherDeg);

    // Angle between fragment direction and cone edge direction.
    highp float angle = acos(clamp(dot(dir, coneDir), -1.0, 1.0));

    // Signed angular distance from the cone edge (positive = inside cone).
    highp float angleFromEdge = halfCone - angle;

    // Convert the *angular* feather into a CONSTANT pixel width by
    // referencing it against maxDist (the cone's reach) instead of
    // the current fragment's distance. This is what keeps the fade
    // band a fixed width in pixels regardless of how far out you are.
    highp float featherPixels = max(featherRad * maxDist, 0.0001);

    // Perpendicular pixel distance from the edge, signed.
    highp float edgePixelDist = angleFromEdge * dist;

    // Smooth over a constant pixel width.
    highp float angleMask = smoothstep(-featherPixels, 0.0, edgePixelDist);

    highp float scaledFreedom = freedom * min(screenSize.x, screenSize.y);
    highp float freedomMask = 1 - smoothstep(
        scaledFreedom * coneDistanceFeather,
        scaledFreedom,
        dist
    );

    return clamp(distMask * angleMask + freedomMask, 0.0, 1.0);
}

void fragment()
{
    // Bilinear blur in x and y.
    highp vec4 blurred = zTextureSpec(SCREEN_TEXTURE, UV) * BLUR_WEIGHT[0];
    for (int i = 1; i < 3; i++) {
        blurred += zTextureSpec(SCREEN_TEXTURE, (UV + vec2(0.0, BLUR_OFFSET[i] * SCREEN_PIXEL_SIZE.y))) * BLUR_WEIGHT[i];
        blurred += zTextureSpec(SCREEN_TEXTURE, (UV - vec2(0.0, BLUR_OFFSET[i] * SCREEN_PIXEL_SIZE.y))) * BLUR_WEIGHT[i];
        blurred += zTextureSpec(SCREEN_TEXTURE, (UV + vec2(BLUR_OFFSET[i] * SCREEN_PIXEL_SIZE.x, 0.0))) * BLUR_WEIGHT[i];
        blurred += zTextureSpec(SCREEN_TEXTURE, (UV - vec2(BLUR_OFFSET[i] * SCREEN_PIXEL_SIZE.x, 0.0))) * BLUR_WEIGHT[i];
    }

    // Monochrome the view.
    highp float gray = zGrayscale(blurred.rgb);

    // Shade it to the phosphor color.
    highp vec3 colorized = gray * BASE_COLOR * AMPLIFICATION;

    // Screen size in pixels.
    highp vec2 screenSize = vec2(1.0 / SCREEN_PIXEL_SIZE.x, 1.0 / SCREEN_PIXEL_SIZE.y);

    lowp float staticBase = zRandom(FRAGCOORD.xy * (SCREEN_PIXEL_SIZE) + vec2(fract(TIME))).x;
    lowp vec4 staticFx = vec4(vec3(staticBase * staticEnvMul + staticBase), 1.0);

    // Re-expand and add the original alpha back, and add some static.
    highp vec4 walpha = vec4(colorized, blurred.a) + (staticFx * 0.002 * AMPLIFICATION);

    // --- NV-composited scene (cone-masked if applicable) ---
    highp vec4 sceneNV;
    if (IS_CONE) {
        highp float cone = coneMask(
            FRAGCOORD.xy,
            screenSize,
            CONE_ANGLE,
            CONE_FEATHER,
            CONE_DISTANCE,
            CONE_DISTANCE_FEATHER,
            VIEW_ANGLE,
            FREEDOM,
            ZOOM
        );

        // zAdjustResult(LIGHT * MODULATE * COLOR)
        // staticFx * vec4(vec3(0.1 * zGrayscale(LIGHT.rgb) * BASE_COLOR), 1.0)

        sceneNV = mix(vec4(vec3(0.0), 1), walpha, cone);
    } else {
        sceneNV = walpha;
    };

    // --- Plain (non-NV) scene: fully raw passthrough. Must NOT go through
    // zTextureSpec, since that function may apply a color-space decode or
    // other processing meant only for the blur/NV math -- we want this
    // path to be bit-for-bit what's already on screen.
    highp vec4 scenePlain = texture(SCREEN_TEXTURE, UV);

    // --- Time-driven top-to-bottom wipe ---
    highp float a = clamp(abs(TIME_FRACTION), 0.0, 1.0);
    highp float wipeProgress = 1.0 - abs(2.0 * a - 1.0);

    highp float showNV = step(a, 0.5);
    highp vec4 sceneBase = mix(scenePlain, sceneNV, showNV);

    highp float f = max(WIPE_FEATHER, 0.0001);
    highp float wipeLine = mix(-f - 0.001, 1.0 + f + 0.001, wipeProgress);
    highp float fadeAlpha = 1.0 - smoothstep(wipeLine - f, wipeLine + f, 1.0 - UV.y);

    COLOR = mix(sceneBase, vec4(vec3(0.0), 1.0), fadeAlpha);

    // no `* LIGHT`, i guess. it seems like its already applied somewhere up the chain
    gl_FragColor = zAdjustResult(COLOR * MODULATE);
    return;
}
