light_mode unshaded;

// tgui's scrollable Tabs mask-image, applied to the tabs drawn into an offscreen target. It must match KsTguiTabsMask.Alpha.
//      Alpha is 0 up to maskOpaqueFraction * the fade, ramps to 1 at the fade, and the same mirrored at the right. A fade of 0
//      is not masked.
//
// The target holds premultiplied colour, but a source shader is blended normally (SrcAlpha, OneMinusSrcAlpha): its blend mode
//      comes from this header alone, and the header has no premultiplied mode. So the colour is divided by its alpha and the
//      mask goes on the alpha only; normal blending then multiplies the colour back by both, faded by MODULATE, which is
//      exactly a premultiplied blend of the masked strip.

uniform highp float stripWidth;
uniform highp float leftFade;
uniform highp float rightFade;
uniform highp float opaqueFraction;

void fragment()
{
    highp float x = UV2.x * stripWidth;
    highp float alpha = 1.0;

    if (leftFade > 0.0)
    {
        highp float start = leftFade * opaqueFraction;
        alpha *= clamp((x - start) / (leftFade - start), 0.0, 1.0);
    }

    if (rightFade > 0.0)
    {
        highp float start = stripWidth - rightFade;
        highp float end = stripWidth - rightFade * opaqueFraction;
        alpha *= 1.0 - clamp((x - start) / (end - start), 0.0, 1.0);
    }

    highp vec4 texel = zTexture(UV);
    COLOR = vec4(texel.rgb / max(texel.a, 0.0001), texel.a * alpha);
}
