light_mode unshaded;

// The engine maps `add` to BlendFunc(SrcAlpha, DstAlpha), so COLOR.a is written as 1 for a plain src + dst.
blend_mode add;

uniform highp float strength;

void fragment()
{
    // Premultiplied, as it was blended over black, so the colour is already weighted by how much glow there is.
    highp vec4 glow = zTexture(UV);
    COLOR = vec4(glow.rgb * strength, 1.0);
}
