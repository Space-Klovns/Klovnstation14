uniform sampler2D maskTexture;
uniform highp vec4 maskUV;

varying highp vec2 maskUVOut;

void vertex() {
    maskUVOut = mix(maskUV.xy, maskUV.zw, tCoord2);
}

void fragment()
{
    highp vec4 targetc = zTexture(UV);
    highp vec4 maskc = texture(maskTexture, maskUVOut); //texture2D(maskTexture, maskUVOut);

    targetc.a *= maskc.a;
    COLOR = targetc;
}
