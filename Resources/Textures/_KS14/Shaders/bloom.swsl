light_mode unshaded;

uniform highp float bloom_intensity = 1.5;
uniform highp float threshold = 0.15;
uniform highp float bloom_softness = 0.15;

void fragment() {
    highp vec4 base = texture(TEXTURE, UV);

    const highp float kernel[9] = float[9](
        1.0, 2.0, 1.0,
        2.0, 4.0, 2.0,
        1.0, 2.0, 1.0
    );

    const highp vec2 offsets[9] = vec2[9](
        vec2(-1.0, -1.0), vec2(0.0, -1.0), vec2(1.0, -1.0),
        vec2(-1.0,  0.0), vec2(0.0,  0.0), vec2(1.0,  0.0),
        vec2(-1.0,  1.0), vec2(0.0,  1.0), vec2(1.0,  1.0)
    );

    highp vec3 blur = vec3(0.0);
    highp float total = 0.0;

    for (int i = 0; i < 9; i++) {
        highp vec3 s = texture(
            TEXTURE,
            UV + offsets[i] * TEXTURE_PIXEL_SIZE
        ).rgb;

        highp float brightness = dot(
            s, vec3(0.299, 0.587, 0.114)
        );

        highp float mask = smoothstep(
            threshold,
            threshold + bloom_softness,
            brightness
        );

        blur += s * mask * kernel[i];
        total += kernel[i];
    }

    blur /= total;

    // Screen blend prevents harsh additive color buildup.
    highp vec3 glow = blur * bloom_intensity;
    highp vec3 result = 1.0 - (1.0 - base.rgb) * (1.0 - glow);

    // Keep the bloom subtle.
    result = mix(base.rgb, result, 0.25);

    COLOR = vec4(result, base.a);
}
