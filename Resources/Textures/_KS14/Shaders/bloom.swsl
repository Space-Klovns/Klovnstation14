light_mode unshaded;

// No initialisers here: GLSL ES (compatibility mode) refuses them, and the shader fails to compile. The defaults
//      (bloom_intensity 1.5, threshold 0.15, bloom_softness 0.15) are the Emissive prototype's params.
uniform highp float bloom_intensity;
uniform highp float threshold;
uniform highp float bloom_softness;

void fragment() {
    highp vec4 base = texture2D(TEXTURE, UV);

    highp vec3 blur = vec3(0.0);
    highp float total = 0.0;

    // A 3x3 tent (1 2 1 / 2 4 2 / 1 2 1), row by row. Loops, not a const table: GLSL ES 1.0 (compatibility mode) has
    //      neither const arrays nor array constructors.
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            highp vec2 offset = vec2(float(x), float(y));
            highp float kernel = (2.0 - abs(offset.x)) * (2.0 - abs(offset.y));

            highp vec3 s = texture2D(
                TEXTURE,
                UV + offset * TEXTURE_PIXEL_SIZE
            ).rgb;

            highp float brightness = dot(
                s, vec3(0.299, 0.587, 0.114)
            );

            highp float mask = smoothstep(
                threshold,
                threshold + bloom_softness,
                brightness
            );

            blur += s * mask * kernel;
            total += kernel;
        }
    }

    blur /= total;

    // Screen blend prevents harsh additive color buildup.
    highp vec3 glow = blur * bloom_intensity;
    highp vec3 result = 1.0 - (1.0 - base.rgb) * (1.0 - glow);

    // Keep the bloom subtle.
    result = mix(base.rgb, result, 0.25);

    COLOR = vec4(result, base.a);
}
