light_mode unshaded;

uniform highp float bloom_intensity = 1;
uniform highp float bloom_radius = 2.0;

void fragment() {
    vec4 color = zTexture(UV);
    
    // Optimized 9-tap Gaussian blur (circular pattern)
    vec4 blur = vec4(0.0);
    
    // Center weight (heaviest)
    blur += color * 0.16;
    
    // Cross pattern (4 samples)
    blur += zTexture(UV + vec2(1.0, 0.0) * TEXTURE_PIXEL_SIZE * bloom_radius) * 0.13;
    blur += zTexture(UV + vec2(-1.0, 0.0) * TEXTURE_PIXEL_SIZE * bloom_radius) * 0.13;
    blur += zTexture(UV + vec2(0.0, 1.0) * TEXTURE_PIXEL_SIZE * bloom_radius) * 0.13;
    blur += zTexture(UV + vec2(0.0, -1.0) * TEXTURE_PIXEL_SIZE * bloom_radius) * 0.13;
    
    // Diagonal pattern (4 samples)
    vec2 diag = vec2(0.707, 0.707); // sqrt(0.5)
    blur += zTexture(UV + diag * TEXTURE_PIXEL_SIZE * bloom_radius) * 0.11;
    blur += zTexture(UV + vec2(-diag.x, diag.y) * TEXTURE_PIXEL_SIZE * bloom_radius) * 0.11;
    blur += zTexture(UV + vec2(diag.x, -diag.y) * TEXTURE_PIXEL_SIZE * bloom_radius) * 0.11;
    blur += zTexture(UV + -diag * TEXTURE_PIXEL_SIZE * bloom_radius) * 0.11;
    
    // Add bloom to original
    COLOR = color + blur * bloom_intensity;
}
