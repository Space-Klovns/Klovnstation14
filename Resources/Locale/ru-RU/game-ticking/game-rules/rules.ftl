# Respawning
rule-respawn-in-seconds = Возрождение через { $second } { $second ->
    [one] секунду
    [few] секунды
    *[other] секунд
}...

# General
rule-restarting-in-seconds = Перезапуск через { $seconds } { $seconds ->
    [one] секунду
    [few] секунды
    *[other] секунд
}.

rule-time-has-run-out = Время вышло!
