# Resources\Prototypes\_KsModule\FieldCommand\units.yml
ent-KsWeaponPistolMk1FieldCommander = mk 1
    .desc = Mk1 — первый прототип Mk58 — представляет собой довольно устаревший полуавтоматический пистолет с простым механизмом отдачи, лишенный основных усовершенствований, касающихся как точности, так и скорострельности, которые были внедрены в более поздних моделях. Благодаря своей простой конструкции он пользуется популярностью среди производителей нелегального оружия. Питание осуществляется из пистолетных магазинов калибра .35.
    .suffix = KS14, NPC, Полевой командир
ent-KsWeaponShotgunBulldogFieldCommander = Бульдог
    .desc = Автоматический магазинный дробовик для ведения ближнего боя. Бьёт как мул на стероидах. Использует патроны калибра .50 ружейный.
    .suffix = KS14, NPC, Полевой командир
ent-KsWeaponRifleEstocFieldCommander = Модифицированный Estoc DMR
    .desc = Вариант снайперской винтовки «Estoc» с несколькими нестандартными модификациями, значительно повышающими точность за счёт увеличения габаритов.
    .suffix = KS14, NPC, Полевой командир
