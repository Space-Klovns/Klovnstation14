# Resources\Prototypes\_KsModule\FieldCommand\units.yml
ent-KsWeaponPistolMk1FieldCommander = mk 1
    .desc = Mk1 — первый прототип Mk58 — представляет собой довольно устаревший полуавтоматический пистолет с простым механизмом отдачи, лишенный основных усовершенствований, касающихся как точности, так и скорострельности, которые были внедрены в более поздних моделях. Благодаря своей простой конструкции он пользуется популярностью среди производителей нелегального оружия. Питание осуществляется из пистолетных магазинов калибра .35.
    .suffix = KS14, NPC, Полевой командир
ent-KsWeaponShotgunBulldogFieldCommander = Бульдог
    .desc = Автоматический магазинный дробовик для ведения ближнего боя. Бьёт как мул на стероидах. Использует патроны калибра .50 ружейный.
    .suffix = KS14, NPC, Полевой командир
ent-KsWeaponRifleEstocFieldCommander = Модифицированный Estoc DMR
    .desc = Вариант снайперской винтовки «Estoc» с несколькими нестандартными модификациями, значительно повышающими точность за счёт увеличения габаритов.
    .suffix = KS14, NPC, Полевой командир
ent-KsBulletAntiMaterielFieldCommander = пуля (.60 бронебойная)
    .desc = Если вы это видите, вы скорее всего мертвы!
ent-KsCartridgeAntiMaterielFieldCommander = патрон (.60 крупнокалиберный)
    .desc = Мощный патрон для высокоточных винтовок.
ent-KsWeaponSniperHristovFieldCommander = Христов
    .desc = Для тех случаев, когда вам абсолютно необходимо заставить кого-то пожалеть о своих жизненных выборах, находясь на безопасном расстоянии. Использует патроны калибра .60 крупнокалиберный.
    .suffix = KS14, NPC, Полевой командир
ent-KsWeaponLightMachineGunL6FieldCommander = L6 SAW
    .desc = Разработанный компанией Waffle Corp, ручной пулемёт L6 — смертоносное оружие, которое часто используют Мародёры Горлекса. Громоздкий и неудобный, он благодаря тяжёлому стволу и большому боезапасу отлично подходит для подавления противника градом пуль. Питается от лент калибра .30.
    .suffix = KS14, NPC, Полевой командир
ent-KsWeaponShotgunBulldogBreacher = Бульдог
    .desc = Автоматический магазинный дробовик для ведения ближнего боя. Бьёт как мул на стероидах. Использует патроны калибра .50 ружейный.
    .suffix = KS14, NPC, Полевой командир, Подрывник
ent-KsFcMortar = миномёт
    .desc = Лёгкий миномёт, вкопанный там, где стоит. Кто им управляет, тот и выбирает азимут и дальность.
    .suffix = Полевой командир
    .gender = male
