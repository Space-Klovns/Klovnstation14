cmd-ksportallink-desc = Links two portals to each other one-to-one, replacing any links either had.
cmd-ksportallink-help = Usage: ksportallink <portal A> <portal B>
cmd-ksportallink-invalid-args = Expected exactly two arguments: ksportallink <portal A> <portal B>
cmd-ksportallink-bad-uid = '{ $value }' is not an existing entity.
cmd-ksportallink-not-a-portal = { $entity } has no PortalComponent.
cmd-ksportallink-same-entity = A portal cannot be linked to itself.
cmd-ksportallink-failed = Could not link those portals.
cmd-ksportallink-success = Linked { $first } and { $second }.
cmd-ksportallink-first-completion = <portal A>
cmd-ksportallink-second-completion = <portal B>

cmd-ksportalunlink-desc = Removes every link from a portal.
cmd-ksportalunlink-help = Usage: ksportalunlink <portal>
cmd-ksportalunlink-invalid-args = Expected exactly one argument: ksportalunlink <portal>
cmd-ksportalunlink-success = Unlinked { $entity }.
