cmd-ksparticles-desc = Spawns a particle emitter on an entity, yours by default, to look at a particle prototype.
cmd-ksparticles-help = Usage: ksparticles <ksParticles prototype> [target net entity] [-t <seconds>]
cmd-ksparticles-invalid-args = Give a particle prototype id.
cmd-ksparticles-unknown-prototype = No ksParticles prototype is called '{ $prototype }'.
cmd-ksparticles-bad-target = '{ $target }' is not a net entity.
cmd-ksparticles-bad-lifetime = -t takes a positive number of seconds.
cmd-ksparticles-no-target = No target: give a net entity, or run this attached to an entity.
cmd-ksparticles-success = Spawned { $prototype } as { $emitter } on { $target }.
cmd-ksparticles-prototype-completion = <ksParticles prototype>
cmd-ksparticles-target-completion = [target net entity] [-t <seconds>]

cmd-ksparticles_clear-desc = Deletes every bare particle emitter entity.
cmd-ksparticles_clear-help = Usage: ksparticles_clear
cmd-ksparticles_clear-success = Deleted { $count } particle emitter(s).
