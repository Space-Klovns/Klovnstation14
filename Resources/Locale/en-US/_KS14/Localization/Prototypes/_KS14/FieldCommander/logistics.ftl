# Resources\Prototypes\_KS14\FieldCommander\logistics.yml
ent-KsFieldCommanderTechFab = field tech fab
    .desc = A military tech fab that prints what a field commander needs, anything an autolathe or a security tech fab makes, plus drones, bandages, sandbags and barbed wire. It is bolted to the ground and cannot be taken apart.
ent-KsMaterialSiloFieldCommander = material silo
    .desc = An advanced machine, capable of using bluespace technology to transmit materials to nearby machines. This one starts stocked with plastic, cannot be damaged and cannot be taken apart.
    .suffix = Field Commander
