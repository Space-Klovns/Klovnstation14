# Resources\Prototypes\_KS14\Entities\Structures\Machines\datalink.yml
ent-KsMachineDatalinkPublicBeacon = public datalink beacon
    .desc = A public navigation beacon. It announces this grid's position on every datalink channel across the whole sector, so anyone listening can see it. Meant for stations and public landmarks.
    .suffix = public, powered, destroyable

# Resources\Prototypes\_KS14\Entities\Structures\Machines\datalink.yml
ent-KsMachineDatalinkPublicBeaconPermanent = public datalink beacon
    .desc = A permanently-running public navigation beacon. It announces this grid's position on every datalink channel across the whole sector, so anyone listening can see it - and nothing short of deleting the grid will silence it.
    .suffix = public, indestructible, unpowered

# Resources\Prototypes\_KS14\Entities\Structures\Machines\datalink.yml
ent-KsMachineDatalinkReceiver = datalink receiver
    .desc = Listens on a tunable frequency and folds whatever it hears into this grid's sensor picture - an easy way to borrow another grid's eyes, if you can guess their channel.

# Resources\Prototypes\_KS14\Entities\Structures\Machines\datalink.yml
ent-KsMachineDatalinkReceiverCircuitboard = datalink receiver machine board
    .desc = An electronics board used in datalink receivers.

# Resources\Prototypes\_KS14\Entities\Structures\Machines\datalink.yml
ent-KsMachineDatalinkTransmitter = datalink transmitter
    .desc = Broadcasts everything this grid's sensors know on a tunable frequency. Anyone listening on the same channel hears it - allies and enemies alike.

# Resources\Prototypes\_KS14\Entities\Structures\Machines\datalink.yml
ent-KsMachineDatalinkTransmitterCircuitboard = datalink transmitter machine board
    .desc = An electronics board used in datalink transmitters.
