# Resources\Prototypes\_KS14\Entities\Structures\Storage\Canisters\gas_canisters.yml
ent-EncaliteCanister = encalite canister
    .desc = A canister that can contain any type of gas. This one is supposed to contain encalite. It can be attached to connector ports using a wrench.

# Resources\Prototypes\_KS14\Entities\Structures\Storage\Canisters\gas_canisters.yml
ent-EncaliteCanisterBroken = broken gas canister
    .desc = A broken gas canister. Not useless yet, as it can be salvaged for high quality materials.

