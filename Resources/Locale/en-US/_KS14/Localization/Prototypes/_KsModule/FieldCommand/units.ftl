# Resources\Prototypes\_KsModule\FieldCommand\units.yml
ent-KsWeaponPistolMk1FieldCommander = mk 1
    .desc = The first prototype of the Mk58, the Mk1 is a rather outdated semi-automatic pistol with a simple recoil-operated action, lacking the major improvements in both accuracy and firing speed made by the later models. Its simple design makes it a favorite among more illicit manufacturers. Feeds from .35 pistol magazines.
    .suffix = KS14, NPC, Field Commander
ent-KsWeaponShotgunBulldogFieldCommander = Bulldog
    .desc = An automatic magazine-fed shotgun for close-quarters combat. Kicks like a mule on steroids. Uses .50 shotgun shells.
    .suffix = KS14, NPC, Field Commander
ent-KsWeaponRifleEstocFieldCommander = modified Estoc DMR
    .desc = A variant of the 'Estoc' DMR with several non-standard modifications present, heavily improving accuracy at the cost of making it bulkier.
    .suffix = KS14, NPC, Field Commander
