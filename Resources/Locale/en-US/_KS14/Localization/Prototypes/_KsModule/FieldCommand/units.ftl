# Resources\Prototypes\_KsModule\FieldCommand\units.yml
ent-KsWeaponPistolMk1FieldCommander = mk 1
    .desc = The first prototype of the Mk58, the Mk1 is a rather outdated semi-automatic pistol with a simple recoil-operated action, lacking the major improvements in both accuracy and firing speed made by the later models. Its simple design makes it a favorite among more illicit manufacturers. Feeds from .35 pistol magazines.
    .suffix = KS14, NPC, Field Commander
ent-KsWeaponShotgunBulldogFieldCommander = Bulldog
    .desc = An automatic magazine-fed shotgun for close-quarters combat. Kicks like a mule on steroids. Uses .50 shotgun shells.
    .suffix = KS14, NPC, Field Commander
ent-KsWeaponRifleEstocFieldCommander = modified Estoc DMR
    .desc = A variant of the 'Estoc' DMR with several non-standard modifications present, heavily improving accuracy at the cost of making it bulkier.
    .suffix = KS14, NPC, Field Commander
ent-KsBulletAntiMaterielFieldCommander = bullet (.60 anti-materiel)
    .desc = If you can see this you're probably dead!
ent-KsCartridgeAntiMaterielFieldCommander = cartridge (.60 anti-materiel)
    .desc = A high-power cartridge used by high-precision rifles.
ent-KsWeaponSniperHristovFieldCommander = Hristov
    .desc = For when you absolutely, positively need to make someone regret their life choices from a safe distance. Uses .60 anti-materiel ammo.
    .suffix = KS14, NPC, Field Commander
ent-KsWeaponLightMachineGunL6FieldCommander = L6 SAW
    .desc = Developed by Waffle Corp, the L6 Squad Automatic Weapon is a deadly light machine gun often used by the Gorlex Marauders. Although bulky and cumbersome, its heavy barrel and high ammo capacity make it perfect for suppressing combatants with a hail of bullets. Feeds from .30 ammo belts.
    .suffix = KS14, NPC, Field Commander
ent-KsWeaponShotgunBulldogBreacher = Bulldog
    .desc = An automatic magazine-fed shotgun for close-quarters combat. Kicks like a mule on steroids. Uses .50 shotgun shells.
    .suffix = KS14, NPC, Field Commander, Breacher
ent-KsFcMortar = mortar
    .desc = A light mortar, dug in where it stands. Whoever crews it picks the bearing and the distance.
    .suffix = Field Commander
