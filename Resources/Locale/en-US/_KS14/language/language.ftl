# Chat rendering
ks-language-chat-tag = [bold]({$language})[/bold]
ks-language-obfuscation-incomprehensible = (something incomprehensible)

# Languages
ks-language-KsLangCommon-name = Galactic Common
ks-language-KsLangCommon-description = The interstellar lingua franca. Everyone speaks it, few remember learning it.

ks-language-KsLangVox-name = Vox-pirin
ks-language-KsLangVox-description = The shrieking, clicking tongue of the Vox. Mostly delivered at a volume the Vox insist is a whisper.

ks-language-KsLangDwarvish-name = Dwarvish
ks-language-KsLangDwarvish-description = A rumbling mountain tongue that sounds like an argument even when it is a lullaby.

ks-language-KsLangKlovnish-name = Klovnish
ks-language-KsLangKlovnish-description = The ancient performing tongue of the honkfolk. Linguists maintain it has sixteen distinct honks for "trust me". Mimes famously understand every word and have never once replied.

ks-language-KsLangSyndicate-name = Syndicate Cant
ks-language-KsLangSyndicate-description = A clipped operational cipher-tongue drilled into field agents. Terse, deniable, and not taught anywhere legally.

# Voice trigger examine
ks-language-voice-trigger-language = The recorded phrase sounds like {$language}.
ks-language-voice-trigger-understood = You understand it as: "{$keyphrase}"

# Selection window
ks-language-menu-title = Languages
ks-language-menu-choose = Speak
ks-language-menu-current = Speaking
ks-language-menu-understood-header = Understood only
ks-language-menu-default-only = You speak Galactic Common.

# Uplink
ks-uplink-cant-implanter-name = Cant Implanter
ks-uplink-cant-implanter-desc = Teaches the recipient the syndicate field cant. Coordinate openly; be understood by no one.

# Character creation traits
trait-category-ks-languages = Languages
ks-trait-lang-vox-name = Vox-pirin
ks-trait-lang-vox-description = You speak and understand Vox-pirin, the shrieking tongue of the Vox. Pointless if your species already speaks it.
ks-trait-lang-dwarvish-name = Dwarvish
ks-trait-lang-dwarvish-description = You speak and understand Dwarvish, the rumbling mountain tongue. Pointless if your species already speaks it.
ks-trait-lang-klovnish-name = Klovnish
ks-trait-lang-klovnish-description = You speak and understand Klovnish, the ancient performing tongue of the honkfolk. The clowns will know you as one of their own.

