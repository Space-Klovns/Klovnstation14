## Wuxia fighting styles

martial-art-drunken-fist-name = the Drunken Fist
martial-art-eagle-claw-name = the Eagle Claw
martial-art-wing-chun-name = Wing Chun

wuxia-teachings-DrunkenFist = [bold]You take a swig and remember the way of the Drunken Immortals.[/bold] The drunker you are, the harder you punch, and in combat mode you may sway out of the way of blows.
wuxia-teachings-EagleClaw = [bold]You curl your fingers into talons.[/bold] Your punches are claws, and cut a little deeper.
wuxia-teachings-WingChun = [bold]You settle into a centred stance.[/bold] Your punches are light but tiring.
wuxia-teaching-staggering-lotus = Staggering Lotus Sweep (punch, shove, shove): knock them down and leave them staggering.
wuxia-teaching-immortal-wine = The Drunken Immortal Offers Wine (shove, punch): a huge uppercut that launches them further the drunker you are.
wuxia-teaching-drunken-embrace = Drunken Embrace (grab, punch): a sloppy headbutt that leaves them reeling, and you a little too.
wuxia-teaching-claw-rake = Eagle Claw Rake (punch, punch, punch): a deep, bleeding slash.
wuxia-teaching-eagle-seizes = Eagle Seizes Prey (grab, punch): dig into their pressure points; heavy stamina damage, and they drop everything.
wuxia-teaching-joint-lock = Joint Lock (shove, grab): twist their arm until they drop what they hold.
wuxia-teaching-chain-punch = Chain Punch Flurry (punch four times): four more quick punches that wear them out.
wuxia-teaching-sticky-hands = Sticky Hands (shove, shove): for five seconds the next blow against you is turned aside.
wuxia-teaching-centerline = Centerline Strike (punch, shove): heavy stamina damage, and a knockdown if they're already worn out.

wuxia-combo-staggering-lotus = {CAPITALIZE(THE($user))} spins and sweeps the legs out from under {THE($target)}!
wuxia-combo-immortal-wine = {CAPITALIZE(THE($user))} delivers a spinning uppercut to {THE($target)}!
wuxia-combo-drunken-embrace = {CAPITALIZE(THE($user))} throws a sloppy arm around {THE($target)} and headbutts {OBJECT($target)}!
wuxia-combo-claw-rake = {CAPITALIZE(THE($user))} rakes deep furrows across {THE($target)}!
wuxia-combo-eagle-seizes = {CAPITALIZE(THE($user))} seizes {THE($target)} like an eagle snatching prey!
wuxia-combo-joint-lock = {CAPITALIZE(THE($user))} twists {POSS-ADJ($target)} arm into a painful joint lock!
wuxia-combo-chain-punch = {CAPITALIZE(THE($user))} unleashes a blur of chain punches on {THE($target)}!
wuxia-combo-sticky-hands = {CAPITALIZE(THE($user))} raises a flowing guard, sticking to {POSS-ADJ($target)} arms.
wuxia-combo-centerline = {CAPITALIZE(THE($user))} drives a straight punch into the centerline of {THE($target)}!
wuxia-shout-staggering-lotus = Staggering Lotus Sweep! *hic*
wuxia-shout-immortal-wine = The Drunken Immortal Offers Wine!
wuxia-shout-claw-rake = Eagle Claw Rake!
wuxia-shout-chain-punch = Chain punch!
wuxia-sticky-deflect = {CAPITALIZE(THE($user))} redirects the blow with a flick of the wrist!
wuxia-drunken-sway = {CAPITALIZE(THE($user))} sways drunkenly out of the way!
