# KsMobSpaceAlligator
ent-KsMobSpaceAlligator = space alligator
    .desc = A large, formerly aquatic reptile with a nasty temper.

ks-alligator-death-roll-start = { CAPITALIZE(THE($alligator)) } clamps onto { THE($victim) }'s leg and starts a death roll!
ks-alligator-death-roll-complete = { CAPITALIZE(THE($alligator)) } tears off { THE($victim) }'s leg!
ks-alligator-death-roll-held = The alligator's jaws are locked around your leg!
ks-alligator-chat-wrap-message = [bold][color=red]{ $message }[/color][/bold]

# KsAlligatorMigration
ent-KsAlligatorMigration = Alligator Migration
    .desc = Hostile space alligators enter maintenance.

station-event-ks-alligator-migration-announcement = Attention. Space alligators have been sighted in the maintenance tunnels. Keep clear and report sightings to Security.

# KsSpaceAlligatorCube
ent-KsSpaceAlligatorCube = alligator cube
    .desc = Just add water! Then mind your legs.

# KsSpawnMobSpaceAlligator
ent-KsSpawnMobSpaceAlligator = Space Alligator Spawner
