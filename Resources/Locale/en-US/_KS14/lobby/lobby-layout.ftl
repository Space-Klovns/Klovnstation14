# lobbylayout (Content.Server/_KS14/Lobby/KsLobbyLayoutCommand.cs)
cmd-lobbylayout-desc = Shows or sets the lobby layout every player sees.
cmd-lobbylayout-help = Usage: lobbylayout [auto|tactical|kharkiv]. auto shows kharkiv on clown holidays, tactical otherwise.
cmd-lobbylayout-current = The lobby layout is { $layout } (today, by the server's date: { $today }).
cmd-lobbylayout-set = Lobby layout set to { $layout } for every player.
cmd-lobbylayout-unknown = Unknown lobby layout "{ $layout }". Layouts: { $layouts }.
cmd-lobbylayout-arg-layout = <layout>
