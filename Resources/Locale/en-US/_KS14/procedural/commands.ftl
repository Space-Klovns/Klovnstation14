cmd-ksprocgen_snapshot-desc = Capture painted procgen blobs and entrance contracts as diagnostic JSON.
cmd-ksprocgen_snapshot-help = Usage: ksprocgen_snapshot <grid entity> <stable host key>. Reads markers; does not generate or publish a map.
cmd-ksprocgen_snapshot-invalid-arguments = Provide a grid entity and a stable host key.
cmd-ksprocgen_snapshot-export-failed = Procgen snapshot export failed: {$reason}
