cmd-ksprocgen_theme-desc = Open the procedural room-theme editor.
cmd-ksprocgen_theme-help = Usage: ksprocgen_theme [saved-key]. A saved key opens an editable copy.
ks-procgen-theme-command-error = Run this command as a mapping administrator, optionally with one saved theme key.
ks-procgen-theme-title = Procedural room themes
ks-procgen-theme-name = Theme name
ks-procgen-theme-tiles = Floor tile pack
ks-procgen-theme-walls = Wall, window and door pack
ks-procgen-theme-lights = Lighting pack
ks-procgen-theme-entities = Furniture and equipment pack
ks-procgen-theme-none = None
ks-procgen-theme-density = Furnishing density: { $value }%
ks-procgen-theme-coverage = Lighting coverage goal: { $value }%
ks-procgen-theme-coherent = Group furniture and equipment into coherent activities
ks-procgen-theme-center = Keep the room center open
ks-procgen-theme-loose = Allow loose items
ks-procgen-theme-save = Validate and save theme
ks-procgen-theme-ready = Choose packs and room goals, then save.
ks-procgen-theme-loaded-copy = Loaded an editable copy. Saving creates a new theme key.
ks-procgen-theme-saved = Saved. Keep the key below to reuse this theme.
ks-procgen-theme-error = Theme was not saved: { $detail }
ks-procgen-theme-conflict = The theme revision changed. Your edits have been kept; try saving again.
ks-procgen-theme-truncated = Only the first 256 packs of each kind are shown.
ks-procgen-theme-help = Saved themes select content for any room shape. Reopen a saved key with ksprocgen_theme to create a copy. Each save keeps the previous revision.
ks-procgen-theme-atmosphere = Gas fill profile
ks-procgen-theme-electricity = Electrical distribution profile
ks-procgen-theme-utilities-help = Utilities are checked during generation. Gas filling needs a sealed room. Wired-only electrical profiles lay infrastructure; operating power and stable-at-rest gas require additional runtime support. None leaves that utility unspecified.
