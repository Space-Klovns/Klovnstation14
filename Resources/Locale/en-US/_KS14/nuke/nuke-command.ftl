cmd-nukedetonate-help = nukedetonate [ending] [nuke]
cmd-nukedetonate-invalid-ending = {$ending} is not a cinematic ending.
cmd-nukedetonate-invalid-nuke = {$nuke} is not a nuke.
cmd-nukedetonate-not-found = Can't find an unexploded nuke on any station.
cmd-nukedetonate-already-exploded = That nuke has already exploded.
cmd-nukedetonate-ending-completion = Cinematic ending (optional)
cmd-nukedetonate-nuke-completion = Nuke (optional)
