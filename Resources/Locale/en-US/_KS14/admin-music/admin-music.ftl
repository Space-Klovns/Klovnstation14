# playadminmusic
cmd-playadminmusic-desc = Starts playing a sound at a filepath for the entire server and anyone that joins.
cmd-playadminmusic-help = playadminmusic <audio path> <optional volume 0%-100%>

cmd-playadminmusic-invalid-args = Expected exactly 1 to 2 arguments
cmd-playadminmusic-invalid-path = Invalid path
cmd-playadminmusic-bad-path = Path provided does not point to a valid audio resource
cmd-playadminmusic-fuckoff = This file is already playing
cmd-playadminmusic-invalid-volume = Volume should be a valid number from 0 to 100

cmd-playadminmusic-path-completion = <Audio Path>
cmd-playadminmusic-volume-completion = <Volume>

# stopalladminmusic
cmd-stopalladminmusic-desc = Stops all currently playing admin music.
cmd-stopalladminmusic-help = stopalladminmusic
