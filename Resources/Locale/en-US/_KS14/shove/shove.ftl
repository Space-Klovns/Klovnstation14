
# Shoved into a person, or anything else with no popups of its own.
ks-shove-into-others = {CAPITALIZE(THE($shover))} shoves {THE($target)} into {THE($obstacle)}!
ks-shove-into-user = You shove {THE($target)} into {THE($obstacle)}!
ks-shove-into-target = You're shoved into {THE($obstacle)} by {THE($shover)}!

# Shoved onto a table.
ks-shove-onto-others = {CAPITALIZE(THE($shover))} shoves {THE($target)} onto {THE($obstacle)}!
ks-shove-onto-user = You shove {THE($target)} onto {THE($obstacle)}!
ks-shove-onto-target = You're shoved onto {THE($obstacle)} by {THE($shover)}!

# Shoved against a wall.
ks-shove-wall-others = {CAPITALIZE(THE($shover))} shoves {THE($target)}, knocking {OBJECT($target)} down!
ks-shove-wall-user = You shove {THE($target)}, knocking {OBJECT($target)} down!
ks-shove-wall-target = You're knocked down from a shove by {THE($shover)}!
ks-shove-wall-resisted-others = {CAPITALIZE(THE($shover))} shoves {THE($target)}!
ks-shove-wall-resisted-user = You shove {THE($target)}!
ks-shove-wall-resisted-target = You resist falling down from a shove by {THE($shover)}!

# Shoved while already down.
ks-shove-paralyze-others = {CAPITALIZE(THE($shover))} kicks {THE($target)} onto {POSS-ADJ($target)} side!
ks-shove-paralyze-user = You kick {THE($target)} onto {POSS-ADJ($target)} side!
ks-shove-paralyze-target = You're kicked onto your side by {THE($shover)}!

# Shoved again after that: everything held goes flying.
ks-shove-disarm-others = {CAPITALIZE(THE($shover))} kicks everything out of {THE($target)}'s hands!
ks-shove-disarm-user = You kick everything out of {THE($target)}'s hands!
ks-shove-disarm-target = {CAPITALIZE(THE($shover))} kicks everything out of your hands!
