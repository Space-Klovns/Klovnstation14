cmd-ks_weather-desc = Shows the running dynamic weather, or changes it to a state now.
cmd-ks_weather-help = ks_weather [state]
cmd-ks_weather-hint = <state>
cmd-ks_weather-no-rule = No dynamic weather is running.
cmd-ks_weather-unknown = There is no weather state "{ $state }".
cmd-ks_weather-status = { $rule }: now { $state }. States: { $states }.
