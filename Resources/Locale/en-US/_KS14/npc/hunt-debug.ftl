cmd-ks_huntdebug-desc = Toggles the NPC hunt debug overlay (rooms, ways in, routes round them, search coverage, orders) for you, optionally for one squad only.
cmd-ks_huntdebug-help = ks_huntdebug [squad or NPC]

cmd-ks_huntdebug-no-session = This command must be run by a player.
cmd-ks_huntdebug-invalid-entity = No entity found matching '{$entity}'.
cmd-ks_huntdebug-entity-hint = squad or NPC (optional, shows every hunt if omitted)
cmd-ks_huntdebug-enabled-all = Hunt debug overlay enabled, showing every hunt.
cmd-ks_huntdebug-enabled-single = Hunt debug overlay enabled, showing { $entity }'s hunt only.
cmd-ks_huntdebug-disabled = Hunt debug overlay disabled.
