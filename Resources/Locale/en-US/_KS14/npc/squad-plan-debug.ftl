cmd-ks_squadplandebug-desc = Toggles the NPC squad plan debug overlay (what a squad knows, its plan for a hostile it cannot get at, how far each member's shot gets) for you, optionally for one squad only.
cmd-ks_squadplandebug-help = ks_squadplandebug [squad or NPC]

cmd-ks_squadplandebug-no-session = This command must be run by a player.
cmd-ks_squadplandebug-invalid-entity = No entity found matching '{$entity}'.
cmd-ks_squadplandebug-entity-hint = squad or NPC (optional, shows every squad if omitted)
cmd-ks_squadplandebug-enabled-all = Squad plan debug overlay enabled, showing every squad.
cmd-ks_squadplandebug-enabled-single = Squad plan debug overlay enabled, showing { $entity }'s squad only.
cmd-ks_squadplandebug-disabled = Squad plan debug overlay disabled.
