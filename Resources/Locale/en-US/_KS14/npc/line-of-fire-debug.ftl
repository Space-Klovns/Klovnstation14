cmd-ks_lineoffiredebug-desc = Toggles the NPC line of fire debug overlay (how far each NPC's shot gets, and what stops it) for you, optionally for one NPC only.
cmd-ks_lineoffiredebug-help = ks_lineoffiredebug [NPC]

cmd-ks_lineoffiredebug-no-session = This command must be run by a player.
cmd-ks_lineoffiredebug-invalid-entity = No entity found matching '{$entity}'.
cmd-ks_lineoffiredebug-entity-hint = NPC (optional, shows every NPC if omitted)
cmd-ks_lineoffiredebug-enabled-all = Line of fire debug overlay enabled, showing every NPC.
cmd-ks_lineoffiredebug-enabled-single = Line of fire debug overlay enabled, showing { $entity } only.
cmd-ks_lineoffiredebug-disabled = Line of fire debug overlay disabled.
