<widgets:GhostGui xmlns="https://spacestation14.io"
                  xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Ghost.Widgets"
                  HorizontalAlignment="Center">
    <BoxContainer Orientation="Horizontal">
        <Button Name="ReturnToBodyButton"
                Text="{Loc ghost-gui-return-to-body-button}"/>
        <Button Name="GhostWarpButton"
                Text="{Loc ghost-gui-ghost-warp-button}"/>
        <Button Name="GhostRolesButton"/>

        <!-- KS14: fixed width prevents the proportional-font respawn countdown from changing the HUD layout. -->
        <!-- KS14 upstream markup retained for mergeability: <Button Visible="False" Disabled="True" Name="GhostRespawnButton" Text="{Loc ghost-gui-ghost-respawn-button}"/> -->
        <Button Visible="False"
                Disabled="True"
                Name="GhostRespawnButton"
                SetWidth="160"
                Text="{Loc ghost-gui-ghost-respawn-button}"/>
    </BoxContainer>
</widgets:GhostGui>
