<!-- KS14: reworked into the tactical lobby layout; upstream original kept in LobbyGui.xaml.old -->
<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:viewport="clr-namespace:Content.Client.Viewport"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets">
    <!-- Background -->
    <TextureRect Access="Public"
                 VerticalExpand="True"
                 HorizontalExpand="True"
                 Name="Background"
                 Stretch="KeepAspectCovered"/>

    <!-- Lobby view eye -->
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Name="KsViewportContainer">
        <Control VerticalExpand="True"
                 HorizontalExpand="True">
            <viewport:ScalingViewport Name="KsViewport"
                                      Access="Public"
                                      MinSize="500 500"
                                      MouseFilter="Ignore"/>
        </Control>
    </BoxContainer>

    <!-- Contrast fades; anchored by LobbyGui.xaml.cs -->
    <PanelContainer Name="KsFadeLeft" StyleClasses="KsLobbyFadeLeft" MouseFilter="Ignore"/>
    <PanelContainer Name="KsFadeBottom" StyleClasses="KsLobbyFadeBottom" MouseFilter="Ignore"/>

    <!-- Vertical root: main layout above a full-width bottom bar -->
    <BoxContainer Name="KsRoot" Orientation="Vertical" SeparationOverride="0">
    <BoxContainer Name="MainContainer"
                  VerticalExpand="True"
                  HorizontalExpand="True"
                  Orientation="Horizontal"
                  SeparationOverride="0">
        <SplitContainer State="Auto"
                        ResizeMode="NotResizable"
                        HorizontalExpand="True">
            <!-- LHS Controls -->
            <BoxContainer Name="LeftSide"
                          Orientation="Vertical"
                          SeparationOverride="0"
                          HorizontalExpand="True">
                <Control Name="DefaultState"
                         VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True">
                            <!-- Menu column -->
                            <BoxContainer Name="KsMenuColumn"
                                          Orientation="Vertical"
                                          Margin="60 48 20 16"
                                          MinWidth="260"
                                          SeparationOverride="6">
                                <Label Name="ServerName"
                                       Access="Public"
                                       MaxWidth="460"
                                       StyleClasses="KsLobbyTitle"
                                       HorizontalAlignment="Left"/>
                                <Label Name="StationTime"
                                       Access="Public"
                                       StyleClasses="KsLobbySubtitle"
                                       HorizontalAlignment="Left"/>
                                <PanelContainer StyleClasses="KsLobbyHairline" MinHeight="1" Margin="0 6" HorizontalAlignment="Stretch"/>
                                <!-- Countdown: StartTime is the small caption, StartTimeValue the big number (LobbyGui.KsSetCountdown) -->
                                <Label Name="StartTime"
                                       Access="Public"
                                       Visible="False"
                                       StyleClasses="KsLobbySubtitle"
                                       HorizontalAlignment="Left"/>
                                <!-- Negative top margin: the big face's line height leaves a gap under the caption. -->
                                <Label Name="StartTimeValue"
                                       Access="Public"
                                       Visible="False"
                                       Margin="0 -12 0 0"
                                       StyleClasses="KsLobbyCountdown"
                                       HorizontalAlignment="Left"/>
                                <RichTextLabel Name="PlaytimeComment"
                                               StyleClasses="KsLobbyRichText"
                                               Visible="False"
                                               Access="Public"
                                               MaxWidth="420"
                                               HorizontalAlignment="Left"/>
                                <Control MinHeight="20" VerticalExpand="True"/>
                                <Button Name="ReadyButton"
                                        Access="Public"
                                        ToggleMode="True"
                                        Text="{Loc 'ks-lobby-menu-ready'}"
                                        StyleClasses="KsLobbyMenuButton"
                                        HorizontalAlignment="Left"/>
                                <cc:UICommandButton Command="observe"
                                                    Name="ObserveButton"
                                                    Access="Public"
                                                    Text="{Loc 'ks-lobby-menu-observe'}"
                                                    StyleClasses="KsLobbyMenuButton"
                                                    HorizontalAlignment="Left"
                                                    WindowType="{x:Type lobbyUi:ObserveWarningWindow}"/>
                                <Button Name="ManifestButton"
                                        Access="Public"
                                        Text="{Loc 'ks-lobby-menu-manifest'}"
                                        StyleClasses="KsLobbyMenuButton"
                                        HorizontalAlignment="Left"/>
                                <Button Name="OptionsButton"
                                        Access="Public"
                                        Text="{Loc 'ks-lobby-menu-options'}"
                                        StyleClasses="KsLobbyMenuButton"
                                        HorizontalAlignment="Left"/>
                                <Control MinHeight="18"/>
                                <Button Name="LeaveButton"
                                        Access="Public"
                                        Text="{Loc 'ks-lobby-menu-leave'}"
                                        StyleClasses="KsLobbyMenuButton"
                                        HorizontalAlignment="Left"/>
                                <!-- Voting Popups -->
                                <BoxContainer Orientation="Vertical"
                                              SeparationOverride="4"
                                              Name="VoteContainer"
                                              Access="Public"
                                              HorizontalAlignment="Left"
                                              Margin="0 8"/>
                            </BoxContainer>
                            <!-- Character info block -->
                            <BoxContainer Orientation="Vertical"
                                          HorizontalExpand="True"
                                          VerticalExpand="True">
                                <Control VerticalExpand="True"/>
                                <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview"
                                                                    Access="Public"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0 0 40 0"/>
                                <Control VerticalExpand="True"/>
                            </BoxContainer>
                        </BoxContainer>
                    </BoxContainer>
                </Control>
                <!-- Character setup state -->
                <!-- This is injected on startup. Funky! -->
                <Control Access="Public"
                         Visible="False"
                         Name="CharacterSetupState"
                         VerticalExpand="True"/>
            </BoxContainer>
            <!-- Right Panel -->
            <PanelContainer Name="RightSide"
                            Access="Public"
                            StyleClasses="KsLobbyFadeRight"
                            HorizontalAlignment="Right"
                            VerticalExpand="True"
                            VerticalAlignment="Stretch">
                <BoxContainer Orientation="Vertical"
                              HorizontalExpand="True"
                              Margin="24 10 10 10">
                    <!-- Utility row -->
                    <BoxContainer Orientation="Horizontal"
                                  MinSize="0 30"
                                  Margin="0 10 22 0"
                                  SeparationOverride="6"
                                  HorizontalAlignment="Right">
                        <Button Name="AHelpButton"
                                Access="Public"
                                Text="{Loc 'ks-lobby-menu-ahelp'}"
                                StyleClasses="KsLobbyMenuButtonSmall" VerticalAlignment="Center"/>
                        <vote:VoteCallMenuButton Name="CallVoteButton"
                                                 StyleClasses="KsLobbyMenuButtonSmall" VerticalAlignment="Center"/>
                    </BoxContainer>
                    <PanelContainer StyleClasses="KsLobbyHairline" MinHeight="1" Margin="0 6"/>
                    <!-- Server info -->
                    <Label Text="{Loc 'ks-lobby-subtitle-server-info'}"
                           StyleClasses="KsLobbySubtitle"
                           Margin="0 4"/>
                    <info:ServerInfo Name="ServerInfo"
                                     Access="Public"
                                     StyleClasses="KsLobbyRichText"
                                     MinSize="0 30"
                                     VerticalExpand="false"
                                     MaxWidth="400"
                                     HorizontalAlignment="Left"/>
                    <PanelContainer StyleClasses="KsLobbyHairline" MinHeight="1" Margin="0 8"/>
                    <widgets:ChatBox Name="Chat"
                                     Access="Public"
                                     VerticalExpand="True"
                                     MinHeight="50"/>
                </BoxContainer>
                <TextureButton Name="CollapseButton"
                               TexturePath="filled_right_arrow.svg.192dpi"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0 2 2 0"
                               ModulateSelfOverride="#DEDEDE"
                               Scale="0.5 0.5"/>
            </PanelContainer>
        </SplitContainer>
        <PanelContainer Name="ExpandPanel"
                        StyleClasses="KsLobbyGlass"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 2 2 0"
                        Visible="False">
            <TextureButton Name="ExpandButton"
                           TexturePath="filled_left_arrow.svg.192dpi"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           ModulateSelfOverride="#DEDEDE"
                           Scale="0.5 0.5"/>
        </PanelContainer>
    </BoxContainer>
    <!-- Full-width bottom bar -->
    <BoxContainer Name="KsBottomBar" Orientation="Vertical" SeparationOverride="0">
        <PanelContainer StyleClasses="KsLobbyHairline" MinHeight="1"/>
        <PanelContainer StyleClasses="KsLobbyBottomBar">
            <BoxContainer Orientation="Horizontal" Margin="24 12">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                    <RichTextLabel Name="LobbySong"
                                   Access="Public"
                                   StyleClasses="KsLobbyRichText"
                                   HorizontalAlignment="Left"/>
                    <RichTextLabel Name="LobbyBackground"
                                   Access="Public"
                                   StyleClasses="KsLobbyRichText"
                                   HorizontalAlignment="Left"/>
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <info:LinkBanner Name="LinkBanner"
                                     VerticalExpand="false"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Right"/>
                    <info:DevInfoBanner Name="DevInfoBanner"
                                        VerticalExpand="false"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
    </BoxContainer>
</lobbyUi:LobbyGui>
