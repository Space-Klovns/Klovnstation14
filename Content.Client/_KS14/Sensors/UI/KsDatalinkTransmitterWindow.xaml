<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'ks-datalink-transmitter-ui-title'}"
               MinSize="330 290"
               Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="10">

        <PanelContainer>
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#202025" BorderThickness="1" BorderColor="#404040"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal" Margin="10" HorizontalExpand="True">
                <Label Text="{Loc 'ks-datalink-ui-status-label'}" VerticalAlignment="Center"/>
                <Control MinWidth="5"/>
                <Label Name="StatusLabel" Text="{Loc 'ks-datalink-ui-status-off'}" VerticalAlignment="Center"/>
                <Control HorizontalExpand="True"/>
                <Button Name="ToggleButton" Text="{Loc 'ks-datalink-ui-toggle-button'}"/>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Vertical" SeparationOverride="5" Margin="5 5">
            <Label Text="{Loc 'ks-datalink-ui-frequency-label'}"/>
            <BoxContainer Name="FrequencyBox" Orientation="Horizontal" HorizontalExpand="True">
                <!-- Shown instead of the tuner when the transmitter broadcasts
                     on every channel (a mapping-set public beacon). -->
                <Label Name="FrequencyAllLabel" Visible="False" Text="{Loc 'ks-datalink-ui-frequency-all'}"/>
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Orientation="Vertical" SeparationOverride="5" Margin="5 5">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Text="{Loc 'ks-datalink-ui-power-label'}"/>
                <Control HorizontalExpand="True"/>
                <Label Name="PowerValueLabel" Text="100%"/>
            </BoxContainer>
            <Slider Name="PowerSlider" MinValue="0" MaxValue="100" HorizontalExpand="True" Rounded="True"/>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="5 5">
            <Label Text="{Loc 'ks-datalink-ui-range-label'}"/>
            <Control HorizontalExpand="True"/>
            <Label Name="RangeValueLabel" Text="0"/>
        </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
