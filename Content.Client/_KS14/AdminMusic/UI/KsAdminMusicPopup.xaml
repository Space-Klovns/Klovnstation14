<Control xmlns="https://spacestation14.io"
        MinWidth="300"
        MaxWidth="500">
    <PanelContainer StyleClasses="BackgroundPanel"/>
    <BoxContainer Margin="4"
            Orientation="Vertical">
        <Label Name="VoteCaller"/>
        <RichTextLabel Name="VoteTitle"/>
        <Button Margin="4 4"
                Name="StopMusicButton"
                Text="Stop playing"
                Visible="False"></Button>

        <GridContainer Columns="3"
                Name="VoteOptionsContainer"/>
        <BoxContainer Orientation="Horizontal">
            <ProgressBar Margin="4"
                    HorizontalExpand="True"
                    Name="TimeLeftBar"
                    MinValue="0"
                    MaxValue="1"/>
        </BoxContainer>
    </BoxContainer>
</Control>
