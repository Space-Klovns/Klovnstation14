<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    SetSize="950, 600"
    Title="{Loc 'executor-menu-title'}">
    <PanelContainer Name="CodeControl" SetSize="250, 550" Margin="10" HorizontalAlignment="Left">
        <PanelContainer Name="Buttons" SetSize="200, 65" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="15 0 0 100">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1a1a1a" />
            </PanelContainer.PanelOverride>
            <Button Name="ExecuteButton" SetSize="60, 30" Margin="5 0 0 0" HorizontalAlignment="Left" Text="EXEC"></Button>
            <Button Name="SaveButton" SetSize="60, 30" Text="SAVE"></Button>
        </PanelContainer>
        <PanelContainer Name="Data" SetSize="200, 350" VerticalAlignment="Top" Margin="-15 0 0 0">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1a1a1a" />
            </PanelContainer.PanelOverride>
            <Label Text="{Loc 'executor-menu-data'}" VerticalAlignment="Top"></Label>
            <Label Name="ExecutorLog" Text="" VerticalAlignment="Bottom" Access="Public"></Label>
        </PanelContainer>
    </PanelContainer>
    <PanelContainer Name="CodeInput" SetSize="700, 550" HorizontalAlignment="Right" VerticalAlignment="Center">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#000000" />
        </PanelContainer.PanelOverride>
        <PanelContainer SetSize="700, 550" Name="InputContainer">
            <TextEdit Name="Input" Access="Public" />
        </PanelContainer>
    </PanelContainer>
</controls:FancyWindow>
