<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'iv-drip-window-title'}"
                      MinSize="320 220"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Name="VolumeLabel" StyleClasses="LabelSubText"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Text="{Loc 'iv-drip-window-injection-label'}" VerticalAlignment="Center"/>
            <Control HorizontalExpand="True"/>
            <CheckBox Name="EnabledCheckBox" Text="{Loc 'iv-drip-window-enabled-label'}"/>
        </BoxContainer>
        <Label Name="AmountLabel"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Slider Name="AmountSlider" HorizontalExpand="True"/>
            <LineEdit Name="AmountInput" MinWidth="60"/>
        </BoxContainer>
        <Label Name="IntervalLabel"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Slider Name="IntervalSlider" HorizontalExpand="True"/>
            <LineEdit Name="IntervalInput" MinWidth="60"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
