<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="IV drip"
                      MinSize="320 220"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Name="VolumeLabel" Text="Contents: 0 / 0 u" StyleClasses="LabelSubText"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Text="Injection" VerticalAlignment="Center"/>
            <Control HorizontalExpand="True"/>
            <CheckBox Name="EnabledCheckBox" Text="Enabled"/>
        </BoxContainer>
        <Label Name="AmountLabel" Text="Amount: 0 u"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Slider Name="AmountSlider" MinValue="1" MaxValue="10" Rounded="True" HorizontalExpand="True"/>
            <LineEdit Name="AmountInput" MinWidth="60"/>
        </BoxContainer>
        <Label Name="IntervalLabel" Text="Rate: 0.0 s"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Slider Name="IntervalSlider" MinValue="0.1" MaxValue="10" HorizontalExpand="True"/>
            <LineEdit Name="IntervalInput" MinWidth="60"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>