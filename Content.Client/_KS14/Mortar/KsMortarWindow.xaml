<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:mortar="clr-namespace:Content.Client._KS14.Mortar"
    xmlns:viewport="clr-namespace:Content.Client.Viewport"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc ks-mortar-window-title}"
    MinWidth="320"
    Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <mortar:KsMortarAimControl Name="AimPlot" Access="Public" MinSize="240 240" />
            <BoxContainer Name="SightBox" Access="Public" Orientation="Vertical" SeparationOverride="4" Visible="False">
                <Label Text="{Loc ks-mortar-window-sight}" StyleClasses="LabelSubText" />
                <Control MinSize="180 180" SetSize="180 180" RectClipContent="True">
                    <PanelContainer MouseFilter="Ignore">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#000000" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>
                    <Label Name="SightNoPicture" Text="{Loc ks-mortar-window-sight-no-picture}" HorizontalAlignment="Center" VerticalAlignment="Center" StyleClasses="LabelSubText" />
                    <viewport:ScalingViewport Name="SightView" Access="Public" MouseFilter="Ignore" Visible="False" />
                    <mortar:KsMortarSightReticle Name="SightReticle" />
                </Control>
            </BoxContainer>
        </BoxContainer>
        <Label Name="RangeLabel" StyleClasses="LabelSubText" />
        <GridContainer Columns="5" HSeparationOverride="4" VSeparationOverride="4">
            <Label Text="{Loc ks-mortar-window-bearing}" VerticalAlignment="Center" />
            <Button Name="BearingDownButton" Access="Public" Text="−" MinWidth="28" />
            <LineEdit Name="BearingEdit" Access="Public" MinWidth="80" />
            <Button Name="BearingUpButton" Access="Public" Text="+" MinWidth="28" />
            <Label Name="BearingReadout" Access="Public" MinWidth="72" VerticalAlignment="Center" Margin="4 0 0 0" />
            <Label Text="{Loc ks-mortar-window-distance}" VerticalAlignment="Center" />
            <Button Name="DistanceDownButton" Access="Public" Text="−" MinWidth="28" />
            <LineEdit Name="DistanceEdit" Access="Public" MinWidth="80" />
            <Button Name="DistanceUpButton" Access="Public" Text="+" MinWidth="28" />
            <Control />
        </GridContainer>
        <Label Name="ReasonLabel" Access="Public" FontColorOverride="#FF6060" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Name="RoundsLabel" VerticalAlignment="Center" />
            <ProgressBar Name="ReloadBar" Access="Public" HorizontalExpand="True" VerticalAlignment="Center" MinHeight="12" MinWidth="60" MinValue="0" MaxValue="1" Value="1" />
            <Label Name="StatusLabel" Access="Public" VerticalAlignment="Center" />
        </BoxContainer>
        <Button Name="FireButton" Access="Public" Text="{Loc ks-mortar-window-fire}" HorizontalExpand="True" />
    </BoxContainer>
</controls:FancyWindow>
