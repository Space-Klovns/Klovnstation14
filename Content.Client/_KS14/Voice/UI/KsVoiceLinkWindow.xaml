<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'ks-voice-window-title'}"
                      SetSize="440 300"
                      MinSize="360 260">
    <BoxContainer Name="RootBox"
                  Orientation="Vertical"
                  Margin="10 10 10 10"
                  SeparationOverride="8">
        <RichTextLabel Name="Explanation"/>
        <RichTextLabel Name="Warning"/>
        <Label Name="KeybindLabel"
               StyleClasses="LabelSubText"/>
        <Label Name="StatusLabel"/>
        <BoxContainer Name="ButtonRow"
                      Orientation="Horizontal"
                      SeparationOverride="6">
            <Button Name="OpenButton"
                    Text="{Loc 'ks-voice-window-open'}"
                    Disabled="True"/>
            <Button Name="CopyButton"
                    Text="{Loc 'ks-voice-window-copy'}"
                    Disabled="True"/>
            <Control HorizontalExpand="True"/>
            <Button Name="ResetButton"
                    Text="{Loc 'ks-voice-window-reset'}"
                    ToolTip="{Loc 'ks-voice-window-reset-tooltip'}"
                    StyleClasses="Caution"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
