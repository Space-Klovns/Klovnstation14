<tgui:KsTguiWindow xmlns="https://spacestation14.io"
                   xmlns:tgui="clr-namespace:Content.Client._KS14.UserInterface.Tgui"
                   SetSize="440 240"
                   MinSize="440 200">
    <tgui:KsTguiSection Title="{Loc 'ks-tgui-atmos-filter-title'}"
                        VerticalExpand="True">
        <tgui:KsTguiSectionButtons>
            <tgui:KsTguiButton Name="SelectAllButton"
                               ButtonColor="Transparent"
                               Text="{Loc 'ks-tgui-atmos-filter-select-all'}"/>
            <tgui:KsTguiButton Name="DeselectAllButton"
                               ButtonColor="Transparent"
                               Text="{Loc 'ks-tgui-atmos-filter-select-none'}"/>
            <tgui:KsTguiButton Name="PowerButton"/>
        </tgui:KsTguiSectionButtons>
        <tgui:KsTguiLabeledList>
            <tgui:KsTguiLabeledListItem Label="{Loc 'ks-tgui-atmos-transfer-rate'}">
                <tgui:KsTguiNumberInput Name="RateInput"
                                        SetWidth="63"
                                        Step="1"
                                        TickWhileDragging="True"
                                        Unit="{Loc 'ks-tgui-unit-litres-per-second'}"/>
                <tgui:KsTguiButton Name="MaxButton"
                                   Icon="Plus"
                                   Text="{Loc 'ks-tgui-max'}"
                                   Margin="2 0 0 0"/>
            </tgui:KsTguiLabeledListItem>
            <tgui:KsTguiLabeledListItem Label="{Loc 'ks-tgui-atmos-filter-types'}">
                <GridContainer Name="GasContainer"
                               Columns="3"
                               HorizontalExpand="True"
                               HSeparationOverride="2"
                               VSeparationOverride="2"/>
            </tgui:KsTguiLabeledListItem>
        </tgui:KsTguiLabeledList>
    </tgui:KsTguiSection>
</tgui:KsTguiWindow>
