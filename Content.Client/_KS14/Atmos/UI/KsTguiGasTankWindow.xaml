<tgui:KsTguiWindow xmlns="https://spacestation14.io"
                   xmlns:tgui="clr-namespace:Content.Client._KS14.UserInterface.Tgui"
                   SetSize="300 210"
                   MinSize="300 200">
    <tgui:KsTguiSection>
        <tgui:KsTguiLabeledControls>
            <tgui:KsTguiLabeledControlsItem Label="{Loc 'ks-tgui-atmos-tank-pressure'}">
                <tgui:KsTguiRoundGauge Name="PressureGauge"
                                       DialSize="2"/>
            </tgui:KsTguiLabeledControlsItem>
            <tgui:KsTguiLabeledControlsItem Label="{Loc 'ks-tgui-atmos-tank-regulator'}">
                <tgui:KsTguiButton Name="MinimumButton"
                                   Icon="FastBackward"
                                   VerticalAlignment="Center"
                                   ToolTip="{Loc 'ks-tgui-atmos-tank-regulator-min'}"/>
                <tgui:KsTguiNumberInput Name="ReleaseInput"
                                        SetWidth="65"
                                        Step="1"
                                        VerticalAlignment="Center"
                                        Unit="{Loc 'ks-tgui-unit-kpa'}"/>
                <tgui:KsTguiButton Name="MaximumButton"
                                   Icon="FastForward"
                                   VerticalAlignment="Center"
                                   ToolTip="{Loc 'ks-tgui-atmos-tank-regulator-max'}"/>
                <tgui:KsTguiButton Name="ResetButton"
                                   Icon="Undo"
                                   VerticalAlignment="Center"
                                   ToolTip="{Loc 'ks-tgui-atmos-tank-regulator-reset'}"/>
            </tgui:KsTguiLabeledControlsItem>
        </tgui:KsTguiLabeledControls>
    </tgui:KsTguiSection>
    <tgui:KsTguiSection VerticalExpand="True">
        <tgui:KsTguiLabeledList>
            <tgui:KsTguiLabeledListItem Label="{Loc 'ks-tgui-atmos-tank-internals'}">
                <tgui:KsTguiButton Name="InternalsButton"/>
            </tgui:KsTguiLabeledListItem>
        </tgui:KsTguiLabeledList>
    </tgui:KsTguiSection>
</tgui:KsTguiWindow>
