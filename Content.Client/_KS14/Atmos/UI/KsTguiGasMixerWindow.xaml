<tgui:KsTguiWindow xmlns="https://spacestation14.io"
                   xmlns:tgui="clr-namespace:Content.Client._KS14.UserInterface.Tgui"
                   SetSize="370 175"
                   MinSize="370 175">
    <tgui:KsTguiSection>
        <tgui:KsTguiLabeledList>
            <tgui:KsTguiLabeledListItem Label="{Loc 'ks-tgui-atmos-power'}">
                <tgui:KsTguiButton Name="PowerButton"/>
            </tgui:KsTguiLabeledListItem>
            <tgui:KsTguiLabeledListItem Label="{Loc 'ks-tgui-atmos-output-pressure'}">
                <tgui:KsTguiNumberInput Name="PressureInput"
                                        SetWidth="75"
                                        Step="10"
                                        Unit="{Loc 'ks-tgui-unit-kpa'}"/>
                <tgui:KsTguiButton Name="MaxButton"
                                   Icon="Plus"
                                   Text="{Loc 'ks-tgui-max'}"
                                   Margin="2 0 0 0"/>
            </tgui:KsTguiLabeledListItem>
            <tgui:KsTguiLabeledListItem Name="MainNodeItem"
                                        Label="{Loc 'ks-tgui-atmos-mixer-main-node'}">
                <tgui:KsTguiNumberInput Name="NodeOneInput"
                                        SetWidth="60"
                                        Step="1"
                                        StepPixelSize="2"
                                        MaxValue="100"
                                        TickWhileDragging="True"
                                        Unit="{Loc 'ks-tgui-unit-percent'}"/>
            </tgui:KsTguiLabeledListItem>
            <tgui:KsTguiLabeledListItem Name="SideNodeItem"
                                        Label="{Loc 'ks-tgui-atmos-mixer-side-node'}">
                <tgui:KsTguiNumberInput Name="NodeTwoInput"
                                        SetWidth="60"
                                        Step="1"
                                        StepPixelSize="2"
                                        MaxValue="100"
                                        TickWhileDragging="True"
                                        Unit="{Loc 'ks-tgui-unit-percent'}"/>
            </tgui:KsTguiLabeledListItem>
        </tgui:KsTguiLabeledList>
    </tgui:KsTguiSection>
</tgui:KsTguiWindow>
